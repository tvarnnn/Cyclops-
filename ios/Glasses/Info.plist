<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Begin required section for Device Access Toolkit Apps -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glasses</string>
			</array>
		</dict>
	</array>

	<!-- Lets the SDK detect and open the Meta AI app during registration -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>

	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>

	<key>MWDAT</key>
	<dict>
		<!-- Tell DAT your URL scheme so it can be called back from Meta AI -->
		<key>AppLinkURLScheme</key>
		<string>glasses://</string>
		<!-- Developer Mode value per Meta's DAT SDK Developer Mode setup guidance -->
		<key>MetaAppID</key>
		<string>0</string>
		<!-- Apple Developer Team ID - not used for attestation in Developer Mode -->
		<key>TeamID</key>
		<string>5W593MH533</string>
	</dict>

	<!-- The commit this build was made from, for the DEBUG IMU log's header.
	     Empty unless the build passes GLASSES_BUILD_SHA=<sha> to xcodebuild. -->
	<key>GlassesBuildSHA</key>
	<string>$(GLASSES_BUILD_SHA)</string>

	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to Meta Wearables</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Needed to connect to Meta Wearables</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>This lets your phone find and connect to your glasses over Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<!-- Required for MockCameraKit.setCameraFeed(cameraFacing:), which uses
	     the iPhone's own camera as the simulated Ray-Ban Meta camera feed. -->
	<key>NSCameraUsageDescription</key>
	<string>This app needs camera access to simulate the glasses' camera feed during Mock Device Kit development.</string>
	<!-- End required section for Device Access Toolkit Apps -->

	<!-- App Transport Security: plain ws:// and http:// to a Tower. The Tower
	     does not speak TLS, and Settings says so ("Not encrypted").

	     THIS FILE IS THE RELEASE POLICY. A Release build ships it unchanged:
	       - NSAllowsLocalNetworking: unqualified names and `.local`;
	       - NSExceptionDomains, cleartext allowed: RFC 1918 and link-local
	         IPv4, Tailscale's CGNAT range 100.64.0.0/10, IPv6 unique-local
	         fc00::/7 (Tailscale's fd7a:115c:a1e0::/48 is inside it), and
	         MagicDNS names under ts.net. IP and CIDR keys need iOS 17+
	         (Apple, NSExceptionDomains); this target's minimum is 26.5.
	       - The development Tower's own address stays listed on its own, so
	         the default never depends on CIDR matching.
	     Nothing else: an internet host is refused, and Settings refuses to
	     save one (TowerAddressPolicy.privateNetworks). The two lists must
	     agree; TowerSettingsTests reads this file and checks that they do.

	     A DEBUG build allows arbitrary loads, so the Simulator and a developer
	     can point at any Tower. That is done by the "Derive Info.plist" build
	     phase (project.pbxproj), which, when GLASSES_ATS_ALLOWS_ARBITRARY_LOADS
	     is YES (Debug only), writes a copy of this file with
	     NSAllowsLocalNetworking REMOVED and NSAllowsArbitraryLoads added.
	     Removed, not merely added to: iOS 10+ ignores NSAllowsArbitraryLoads
	     whenever NSAllowsLocalNetworking is present (Apple,
	     NSAllowsArbitraryLoads). A plist cannot be conditional on the
	     configuration by itself - build settings are substituted into values,
	     never into keys - hence the phase. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>100.110.156.55</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>10.0.0.0/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>172.16.0.0/12</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>192.168.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>169.254.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>fc00::/7</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
