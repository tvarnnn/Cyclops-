<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Begin required section for Device Access Toolkit Apps -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glasses</string>
			</array>
		</dict>
	</array>

	<!-- Lets the SDK detect and open the Meta AI app during registration -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>

	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>

	<key>MWDAT</key>
	<dict>
		<!-- Tell DAT your URL scheme so it can be called back from Meta AI -->
		<key>AppLinkURLScheme</key>
		<string>glasses://</string>
		<!-- Developer Mode value per Meta's DAT SDK Developer Mode setup guidance -->
		<key>MetaAppID</key>
		<string>0</string>
		<!-- Apple Developer Team ID - not used for attestation in Developer Mode -->
		<key>TeamID</key>
		<string>5W593MH533</string>
	</dict>

	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to Meta Wearables</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Needed to connect to Meta Wearables</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>This lets your phone find and connect to your glasses over Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<!-- Required for MockCameraKit.setCameraFeed(cameraFacing:), which uses
	     the iPhone's own camera as the simulated Ray-Ban Meta camera feed. -->
	<key>NSCameraUsageDescription</key>
	<string>This app needs camera access to simulate the glasses' camera feed during Mock Device Kit development.</string>
	<!-- End required section for Device Access Toolkit Apps -->

	<!-- V0.5: allow plain ws:// to the development Tower. NSAllowsLocalNetworking
	     covers LAN/RFC1918 addresses; the Tailscale address below is in the CGNAT
	     range (100.64.0.0/10), which that key does not cover, so it needs its own
	     exception. Remove once the Tower speaks wss://. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>100.110.156.55</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
