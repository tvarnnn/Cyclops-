# Tower environment, by example. Copy to `.env` and edit.
#
# `.env` is gitignored and this file is not, deliberately: the VALUES are a
# property of one machine and the LIST is a property of the project. Until
# 2026-08-29 only the list of World Builder variables was written down
# anywhere, and the Object Memory ones lived in whatever a person had last
# typed into their shell -- which is how a physical run came to require
#
#     $env:TOWER_OBSERVATION_VERIFIER="owlv2"
#     $env:TOWER_OBSERVATION_VERIFIER_DEVICE="cuda"
#
# before every launch.
#
# `scripts/start_tower.ps1` hands this file to uvicorn with `--env-file`,
# which loads it in `Config.__init__` -- before the app is imported -- so
# these reach `get_settings()`. It also prints every value below, with where
# it came from, before it binds a port.
#
# EVERY VARIABLE HERE IS OPTIONAL. The defaults in `tower/config.py` are the
# intended configuration; this file exists to override them on a host that
# needs something else, and to make the list discoverable.


# --- Recording -------------------------------------------------------------

# Where captured frames are written. UNSET MEANS NO FRAMES ARE EVER RECORDED,
# and it is also the one thing Object Memory imagery needs: without it the
# imagery routes answer 503 and a memory can be written but never shown.
TOWER_CAPTURE_ROOT=data

# World Builder's tree. Unset means iOS shows World Builder as unsupported.
TOWER_WORLD_ROOT=data/world_builder


# --- World Builder coherence: all OFF by default --------------------------

# Six switches for the coherence product. Off is the Tower as it was before;
# review V8 found it safe to keep merged and not ready to switch on. What each
# does, what it needs and what it cost in the run:
# tower/docs/world-builder/COHERENCE-PRODUCT.md. They are read by the
# processes the Tower spawns (the final solve, the finisher, the builder),
# which inherit the environment the Tower started with: restart the Tower
# after changing one.
# scripts/world_refinish.py runs masks, the gate, its own --seed and the area
# builds whatever these say; the consensus it takes from its own environment.

# Hand/arm/held-phone masks on the FINAL solve's images. GPU.
# TOWER_WORLD_SOLVE_MASKS=false

# An integer >= 0 seeds the final solve's mapper and maps on ONE thread
# (repeatable mapping on a fixed database; about 3.3x the mapping time).
# Unset, blank, `off` or anything else is today's unseeded, multi-threaded solve.
# TOWER_WORLD_SOLVE_SEED=

# Depth before publish, the evidence gate and solve/<session>/components.json.
# Needs the masks: without them it attaches nothing outside the room's
# anchor block.
# TOWER_WORLD_SOLVE_GATE=false

# Consensus: N >= 2 maps N mapper seeds on the gated, seeded final solve's one
# frozen database and decides attachment to the room by strict majority; a
# piece fewer than a majority attached is withheld (`seed-unstable`). Needs
# the gate and the seed. About 250-260 s per extra draw on 678 keyframes, no
# GPU. Unset, blank, garbage, 0 or negative is 1: a single draw.
# TOWER_WORLD_SOLVE_CONSENSUS=1

# The idle finisher builds each `area` the gate named. Off: those areas read
# "could not be built". Needs the gate, and the finisher on
# (TOWER_WORLD_FINISH_PENDING, TOWER_WORLD_SURFACE, TOWER_WORLD_SOLVE).
# TOWER_WORLD_AREA_BUILDS=false

# The live look-back relocalizer: `off`, `prompt` or `silent` (runs, never
# prompts). on/true/yes/1 mean `prompt`; any other word is `off`.
# TOWER_WORLD_RELOCALIZER=off


# --- Object Memory ---------------------------------------------------------

# Off switch for the whole cartridge. `false` makes /object-memory/* answer
# 404 and leaves Start on the phone with nothing to start.
# TOWER_OBSERVATION_ENABLED=true

# One path for the producer AND the read routes. The default is
# <tower>/data/object_memory and needs no setting.
# TOWER_OBSERVATION_ROOT=data/object_memory

# `owlv2` is the default and takes what this Tower records from two classes
# to fourteen (see docs/contracts/OBJECT-MEMORY.md section 11). It loads
# google/owlv2-base-patch16-ensemble -- Apache-2.0, ~600 MB, fetched once and
# cached under ~/.cache/huggingface. A host that cannot load it says so and
# records the two anyway; it does not fail.
#
# Set this to `none` to record only `laptop` and `cell phone`, which are the
# two classes the detector alone was measured to be trustworthy on.
# TOWER_OBSERVATION_VERIFIER=owlv2

# `auto`, `cpu` or `cuda`. `auto` downgrades to CPU where there is no GPU and
# the producer prints the device it actually got on its first line. `cuda`
# also downgrades rather than killing a walk, and says so at WARNING.
#
# The verifier measured 126 ms a crop on this GPU against 2,473 ms on this
# CPU -- a factor of nineteen -- for 620 MB of VRAM. The detector measured
# 69.3 ms/frame on CPU against 100.4 on CUDA, so it is the stage that should
# stay off the contended device if a host is short of one.
# TOWER_OBSERVATION_VERIFIER_DEVICE=auto
# TOWER_OBSERVATION_DEVICE=auto

# How long an observation is kept, and the window the store manifest records
# at first append. A reader may narrow this and nothing can widen it.
# TOWER_OBSERVATION_RETENTION_DAYS=30

# WHETHER THIS CARTRIDGE PERSISTS PIXELS AT ALL. On by default.
#
# On, each observation keeps one small filtered crop under
# <observation root>/keyframes/ -- long side capped at 384 px, measured at a
# median of about 11 KB -- which is deleted when the record expires or is
# purged. That is what lets a memory keep its picture after the recording it
# came from is gone.
#
# Off, no new crop is written and a record's picture is a frame in
# data/captures/ for as long as capture-side retention keeps one. Turning it
# off does NOT delete crops already on disk: they are still served and still
# pruned with their records, because a configuration change is not a deletion
# request. `scripts/object_query.py --purge-all` is.
#
# Spelling matters here and nowhere else does it matter this much. Every
# on/off variable in this file goes through one helper, so that a fourth flag
# cannot arrive with a fifth spelling of "true" -- and the consequence is that
# only `1`, `true`, `yes` and `on` mean true. A blank value means "unset, use
# the default". ANYTHING ELSE, INCLUDING A TYPO, READS AS FALSE, and false
# here means this cartridge stops keeping pictures.
# TOWER_OBSERVATION_KEEP_IMAGERY=true


# --- Privacy ---------------------------------------------------------------

# The YuNet weights, for the face display filter. The default resolves
# `models/face_detection_yunet_2023mar.onnx` RELATIVE TO THE PROCESS CWD --
# which is why start_tower.ps1 sets the working directory, and why launching
# uvicorn from somewhere else silently disables World Builder's redaction.
#
# Object Memory does not fail silently on this. With no weights it writes no
# new keyframe and serves no capture frame, rather than an unfiltered
# first-person one. A keyframe already on disk is still served -- it was
# filtered before it was written, so the check has already been passed.
# TOWER_FACE_REDACTION_MODEL=models/face_detection_yunet_2023mar.onnx


# --- Other cartridges ------------------------------------------------------

# TOWER_DEV_MODE=true
# TOWER_CV_EXPERIMENT=baseline
# TOWER_CV_DEVICE=auto

# Read into Settings and then read back by nothing. Setting them binds no
# port; `start_tower.ps1 -BindHost/-Port` is what decides that.
# TOWER_HOST=
# TOWER_PORT=
